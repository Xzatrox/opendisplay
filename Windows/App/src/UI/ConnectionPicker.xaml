<?xml version="1.0" encoding="utf-8"?>
<!-- OpenDisplay Windows Sender — Connection Picker Control -->
<!-- Displays discovered USB and WiFi devices with USB preference.
     Devices available on both USB and WiFi (same installId) show only the USB entry. -->
<UserControl
    x:Class="OpenDisplay.ConnectionPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenDisplay">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Section header -->
        <TextBlock Grid.Row="0"
                   Text="Devices"
                   Style="{StaticResource BodyStrongTextBlockStyle}"/>

        <!-- Device list -->
        <ListView Grid.Row="1"
                  x:Name="DeviceListView"
                  SelectionMode="Single"
                  SelectionChanged="OnDeviceSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DeviceEntry">
                    <Grid Padding="8,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Transport icon (USB or WiFi) -->
                        <FontIcon Grid.Column="0"
                                  Glyph="{x:Bind TransportGlyph}"
                                  FontSize="20"/>

                        <!-- Device name and transport label -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind TransportLabel}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>

                        <!-- Auto-connect toggle -->
                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{x:Bind AutoConnect, Mode=TwoWay}"
                                      OnContent="Auto"
                                      OffContent=""
                                      ToolTipService.ToolTip="Auto-connect when this device is attached"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state message -->
        <TextBlock Grid.Row="1"
                   x:Name="EmptyStateText"
                   Text="No devices found. Connect an iPad via USB or ensure devices are on the same network."
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                   Visibility="Visible"/>

        <!-- Connect button -->
        <Button Grid.Row="2"
                x:Name="ConnectButton"
                Content="Connect"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                IsEnabled="False"
                Click="OnConnectClicked"/>
    </Grid>
</UserControl>
